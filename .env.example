# Copia este archivo a `.env` y rellena los valores reales.
# NO subas `.env` a git (ya está en .gitignore).

# === MESHTASTIC NODO (TCP) ===
# IP:PUERTO del nodo Meshtastic conectado por TCP (firmware solos acepta 1 cliente)
MESHTASTIC_HOST=192.168.1.116
MESHTASTIC_PORT=4403
MESHTASTIC_TCP=tcp://192.168.1.116:4403

# === BOT IDENTIDAD ===
# ID de nodo del propio bot (formato !XXXXXXXX)
MI_NODO_ID=!02eda160

# === TELEGRAM ===
# Token del bot de Telegram (BotFather)
TELEGRAM_TOKEN=1234567890:AA...tu_token
# Chat/grupo principal del bot
MI_CHAT_ID=-1001234567890
# Chats permitidos, separados por coma
CHATS_PERMITIDOS=133068052,-1002968559479

# === POTATO MESH API ===
# URL y token de la instancia Potato Mesh (ingestora)
POTATO_API_URL=http://192.168.1.100:41447
POTATO_API_TOKEN=cambia_este_token
# Ruta local del repositorio potato-mesh (para potato_fusion)
POTATO_ROOT=/home/nando/potato-mesh

# === SOTA (sota.org.uk) ===
SOTA_USER=TU_INDICATIVO
SOTA_PASS=tu_password

# === AEMET / FIRMS (NASA) ===
# API key de opendata.aemet.es
AEMET_API_KEY=tu_api_key_aemet
# API key de FIRMS (NASA) para incendios
FIRMS_MAP_KEY=tu_api_key_firms

# === IA (GROQ) ===
# API key de Groq (https://console.groq.com)
IA_API_KEY=gsk_...
# Modelo a usar (p.ej. openai/gpt-oss-120b)
IA_MODEL=openai/gpt-oss-120b

# === QRZ (hamqth.com) ===
QRZ_USER=tu_usuario
QRZ_PASS=tu_password

# === MQTT MESHTASTIC ===
MQTT_SERVER=mqtt.meshtastic.pt
MQTT_PORT=1883
MQTT_USER=EA7!
MQTT_PASS=tu_password_mqtt
MQTT_TOPIC=msh/EA7

# === MODEM ===
MODEM_PRESET=SFNarrow
